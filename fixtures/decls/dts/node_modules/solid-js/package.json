{
  "name": "solid-js",
  "main": "./dist/server.cjs",
  "types": "legacy/index.d.ts",
  "exports": {
    ".": {
      "browser": {
        "development": {
          "types": "./types/index.d.ts",
          "import": "./dist/dev.js"
        },
        "import": "./dist/solid.js"
      },
      "types": "./types/index.d.ts",
      "import": "./dist/solid.js"
    },
    "./types/*": "./types/*",
    "./web": {
      "worker": { "import": "./web/dist/server.js" },
      "types": "./web/types/index.d.ts",
      "import": "./web/dist/web.js"
    },
    "./package.json": "./package.json"
  }
}
